# Runtime connection used by the app. For Neon, prefer the pooled URL.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST-POOLER.neon.tech/thinkboard?sslmode=require&channel_binding=require"

# Prisma CLI connection used for migrations and schema commands.
# For Neon, use the direct non-pooled host here when available.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-NEON-HOST.neon.tech/thinkboard?sslmode=require&channel_binding=require"
